<?xml version="1.0" encoding="utf-8"?>
<!-- Este é o layout para o AlertDialog (a janela pop-up) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Este é o botão que seu código Java procura -->
    <Button
        android:id="@+id/buttonDialogSelecionar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecionar Imagem" />

    <!-- Este é o ImageView para o preview -->
    <ImageView
        android:id="@+id/imageViewDialogPreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:contentDescription="Preview da pista" />

</LinearLayout>